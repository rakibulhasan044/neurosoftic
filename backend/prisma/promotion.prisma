model Promotion {
  id             String       @id @default(uuid())
  name           String
  description    String?
  discountType   DiscountType
  discountValue  Float
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  minOrderAmount Float?
  maxDiscount    Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  usageLimit     Int?
  usedCount      Int          @default(0)
  minOrderAmount Float?
  maxDiscount    Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}
